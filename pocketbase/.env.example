# Dramix PocketBase Gateway - Environment Configuration

# Admin master token for license endpoint (generate, list, revoke)
# MUST be a cryptographically secure random string in production
# Generate with: openssl rand -hex 32
PB_ADMIN_LICENSE_TOKEN=pb_master_token_2026_change_in_production

# Gateway host/port
PB_HOST=127.0.0.1
PB_PORT=8090

# Database directory
PB_DATA_DIR=./pb_data
