[Unit]
Description=FreeReels API Proxy Service
Documentation=https://github.com/your-repo/freereels-api
After=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/freereels-api
Environment="PATH=/opt/freereels-api/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin"
ExecStart=/opt/freereels-api/venv/bin/python run_proxy.py
Restart=on-failure
RestartSec=5s

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/opt/freereels-api
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=no
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

# Resource limits
LimitNOFILE=65536

# Logs
StandardOutput=journal
StandardError=journal
SyslogIdentifier=freereels-api

[Install]
WantedBy=multi-user.target
